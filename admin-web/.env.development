# Used by `npm run dev` (vite --mode development). Committed: everything here is PUBLIC (it is built into the page).
# Never put database connection strings, JWT keys or other secrets in any VITE_ variable.
# Override per machine in .env.development.local (git-ignored), e.g. VITE_API_URL=http://192.168.1.53:5000
VITE_API_URL=http://localhost:5000
# Shows the "Quick sign-in" buttons. The API serves dev login only in Development against a local database.
VITE_DEV_LOGIN=true
