# Environment files (all values are PUBLIC: they are built into the page; never put secrets here)
#   .env.development        npm run dev     local API, dev login on
#   .env.production         npm run build   HTTPS API, dev login off (Cloudflare Pages)
#   .env.development.local  your machine only (git-ignored), e.g. a LAN address for the API
VITE_API_URL=http://localhost:5000
VITE_DEV_LOGIN=false
