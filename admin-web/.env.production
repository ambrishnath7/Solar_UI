# Used by `npm run build` (vite --mode production) and by Cloudflare Pages. Committed: everything here is PUBLIC.
# Set VITE_API_URL in Cloudflare Pages > Settings > Environment variables (it overrides this file),
# or replace the placeholder below. The build refuses http:// URLs and dev login (see vite.config.ts).
VITE_API_URL=https://your-api.example.com
VITE_DEV_LOGIN=false
